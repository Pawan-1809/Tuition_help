# ============================================
# Tuition Connect - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Django ──────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Database (PostgreSQL - used in Docker/Production) ──
DB_NAME=tuition_connect
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# ── Redis ───────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Razorpay ────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_REGISTRATION_FEE=499

# ── Google OAuth ────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── SMS / OTP Provider (Twilio) ─────────────
SMS_PROVIDER_SID=your_twilio_sid
SMS_PROVIDER_AUTH_TOKEN=your_twilio_auth_token
SMS_PROVIDER_PHONE=+1234567890
OTP_EXPIRY_SECONDS=300
